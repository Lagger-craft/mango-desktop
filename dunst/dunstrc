[global]
    monitor = 0
    follow = keyboard
    width = 360
    height = (0, 240)
    origin = top-right
    offset = (16, 48)
    notification_limit = 8
    transparency = 0
    separator_height = 2
    padding = 12
    horizontal_padding = 12
    frame_width = 2
    frame_color = "#9bd45a"
    separator_color = frame
    font = "Sans 10"
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    word_wrap = yes
    ignore_newline = no
    show_indicators = yes
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48
    corner_radius = 4

[urgency_low]
    background = "#171a17"
    foreground = "#c8d2c0"
    frame_color = "#607544"
    timeout = 5

[urgency_normal]
    background = "#20231e"
    foreground = "#e5e8dc"
    frame_color = "#e0a044"
    timeout = 8

[urgency_critical]
    background = "#291b19"
    foreground = "#fff0e8"
    frame_color = "#d94b43"
    timeout = 0
