/* Zen Browser theme — generated by mango-desktop/mango/scripts/zen-theme.sh
 *
 * DO NOT EDIT THIS FILE BY HAND: it is regenerated every time the wallpaper
 * changes. Edit zen/userChrome.css.template instead.
 *
 * The palette comes from matugen (Material You) through the same theme.json
 * the Quickshell panel uses, so the browser always matches the desktop.
 *
 * Zen derives most of its surfaces from --zen-primary-color with color-mix();
 * overriding the base tokens below is enough to recolor the whole UI.
 */

:root {
  /* Accent: drives Zen's generated surfaces (buttons, selection, progress). */
  --zen-primary-color: {{accent}};
  --zen-accent-button-background: {{accent}};
  --zen-accent-button-color: {{accentBright}} !important;

  /* Base surfaces. */
  --zen-branding-dark: {{surface}} !important;
  --zen-main-browser-background: {{surface}} !important;
  --zen-main-browser-background-toolbar: {{surfaceUp}} !important;
  --zen-navigator-toolbox-background: {{panelBg}} !important;
  --zen-urlbar-background: {{well}} !important;
  --zen-urlbar-background-base: {{well}} !important;
  --zen-colors-input-bg: {{well}} !important;
  --zen-dialog-background: {{popupBg}} !important;
  --zen-in-content-dialog-background: {{popupBg}} !important;
  --zen-colors-hover-bg: {{hover}} !important;

  /* Lines and separators. */
  --zen-colors-border: {{outline}} !important;
  --zen-input-border-color: {{outline}} !important;
  --zen-appcontent-border: 1px solid {{outline}} !important;

  /* Accent details. */
  --zen-loading-progress-bar-color: {{accent}} !important;
  --zen-essential-tab-selected-bg: {{selectedBg}} !important;
  --zen-essential-tab-icon: {{accent}} !important;
  --zen-sidebar-themed-icon-fill: {{accent}} !important;
}

/* Keep the browser chrome in dark mode with the shell palette. */
:root {
  color-scheme: dark;
}
